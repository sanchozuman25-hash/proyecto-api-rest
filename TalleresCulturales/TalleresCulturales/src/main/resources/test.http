# Peticiones para probar la API (cliente HTTP de IntelliJ).
# Ejecutar en orden con la aplicación recién arrancada (los ids empiezan en 1).

@baseUrl = http://localhost:8080

########## ORGANIZADORES ##########

### POST Crear organizador (id 1)
POST {{baseUrl}}/organizadores
Content-Type: application/json

{
  "nombre": "Centro Cultural Triana",
  "email": "contacto@centrotriana.es"
}

### POST Crear organizador (id 2)
POST {{baseUrl}}/organizadores
Content-Type: application/json

{
  "nombre": "Asociación Cultural Giralda",
  "email": "info@giralda.es"
}

### POST Crear organizador - Error 1 (nombre vacío)
POST {{baseUrl}}/organizadores
Content-Type: application/json

{
  "nombre": "",
  "email": "contacto@centrotriana.es"
}

### POST Crear organizador - Error 2 (email no válido)
POST {{baseUrl}}/organizadores
Content-Type: application/json

{
  "nombre": "Centro Cultural Triana",
  "email": "esto-no-es-un-email"
}

### GET Obtener todos los organizadores
GET {{baseUrl}}/organizadores

### GET Obtener organizador id 1
GET {{baseUrl}}/organizadores/1

### GET Obtener organizador inexistente (404)
GET {{baseUrl}}/organizadores/99

### PUT Modificar organizador id 1
PUT {{baseUrl}}/organizadores/1
Content-Type: application/json

{
  "nombre": "Centro Cultural Triana (renovado)",
  "email": "contacto@centrotriana.es"
}

########## PARTICIPANTES ##########

### POST Crear participante (id 1)
POST {{baseUrl}}/participantes
Content-Type: application/json

{
  "nombreCompleto": "Lucía Fernández Ortiz"
}

### POST Crear participante (id 2)
POST {{baseUrl}}/participantes
Content-Type: application/json

{
  "nombreCompleto": "Carlos Ruiz Medina"
}

### POST Crear participante - Error (nombre vacío)
POST {{baseUrl}}/participantes
Content-Type: application/json

{
  "nombreCompleto": "  "
}

### GET Obtener todos los participantes
GET {{baseUrl}}/participantes

########## TALLERES ##########

### POST Crear taller (id 1)
POST {{baseUrl}}/talleres
Content-Type: application/json

{
  "titulo": "Taller de acuarela",
  "fechaHoraInicio": "2026-11-10T17:00:00",
  "fechaHoraFin": "2026-11-10T19:00:00",
  "organizadorId": 1
}

### POST Crear taller (id 2)
POST {{baseUrl}}/talleres
Content-Type: application/json

{
  "titulo": "Taller de cerámica",
  "fechaHoraInicio": "2026-11-12T18:00:00",
  "fechaHoraFin": "2026-11-12T20:30:00",
  "organizadorId": 2
}

### POST Crear taller - Error 1 (fin igual que inicio)
POST {{baseUrl}}/talleres
Content-Type: application/json

{
  "titulo": "Taller inválido",
  "fechaHoraInicio": "2026-11-10T17:00:00",
  "fechaHoraFin": "2026-11-10T17:00:00",
  "organizadorId": 1
}

### POST Crear taller - Error 2 (fin anterior al inicio)
POST {{baseUrl}}/talleres
Content-Type: application/json

{
  "titulo": "Taller inválido",
  "fechaHoraInicio": "2026-11-10T17:00:00",
  "fechaHoraFin": "2026-11-10T10:00:00",
  "organizadorId": 1
}

### POST Crear taller - Error 3 (título vacío y sin organizador)
POST {{baseUrl}}/talleres
Content-Type: application/json

{
  "titulo": "   ",
  "fechaHoraInicio": "2026-11-10T17:00:00",
  "fechaHoraFin": "2026-11-10T19:00:00"
}

### POST Crear taller - Error 4 (título duplicado, ignorando mayúsculas y espacios) -> 409
POST {{baseUrl}}/talleres
Content-Type: application/json

{
  "titulo": "  TALLER DE ACUARELA ",
  "fechaHoraInicio": "2026-11-10T17:00:00",
  "fechaHoraFin": "2026-11-10T19:00:00",
  "organizadorId": 1
}

### POST Crear taller - Error 5 (organizador inexistente) -> 404
POST {{baseUrl}}/talleres
Content-Type: application/json

{
  "titulo": "Taller huérfano",
  "fechaHoraInicio": "2026-11-10T17:00:00",
  "fechaHoraFin": "2026-11-10T19:00:00",
  "organizadorId": 99
}

### GET Obtener todos los talleres
GET {{baseUrl}}/talleres

### GET Obtener taller id 1
GET {{baseUrl}}/talleres/1

### GET Obtener taller inexistente (404)
GET {{baseUrl}}/talleres/99

### PUT Modificar taller id 1 (conserva su propio título: NO es error)
PUT {{baseUrl}}/talleres/1
Content-Type: application/json

{
  "titulo": "  taller de ACUARELA ",
  "fechaHoraInicio": "2026-11-10T17:00:00",
  "fechaHoraFin": "2026-11-10T20:00:00",
  "organizadorId": 1
}

### PUT Modificar taller id 1 con el título de otro taller -> 409
PUT {{baseUrl}}/talleres/1
Content-Type: application/json

{
  "titulo": "Taller de cerámica",
  "fechaHoraInicio": "2026-11-10T17:00:00",
  "fechaHoraFin": "2026-11-10T20:00:00",
  "organizadorId": 1
}

########## INSCRIPCIONES ##########

### POST Inscribir participante 1 en taller 1
POST {{baseUrl}}/talleres/1/participantes/1

### POST Inscribir participante 2 en taller 1
POST {{baseUrl}}/talleres/1/participantes/2

### POST Inscribir participante 1 en taller 1 otra vez -> 409
POST {{baseUrl}}/talleres/1/participantes/1

### POST Inscribir participante inexistente -> 404
POST {{baseUrl}}/talleres/1/participantes/99

### POST Inscribir en taller inexistente -> 404
POST {{baseUrl}}/talleres/99/participantes/1

### GET Participantes del taller 1
GET {{baseUrl}}/talleres/1/participantes

### GET Participantes del taller 2 (lista vacía)
GET {{baseUrl}}/talleres/2/participantes

### DELETE Eliminar inscripción (participante 2 del taller 1)
DELETE {{baseUrl}}/talleres/1/participantes/2

### DELETE Eliminar inscripción que no existe (sin cambios, 204)
DELETE {{baseUrl}}/talleres/2/participantes/1

########## BORRADOS ##########

### DELETE Eliminar organizador 2 con talleres -> 409
DELETE {{baseUrl}}/organizadores/2

### DELETE Eliminar taller 2
DELETE {{baseUrl}}/talleres/2

### DELETE Eliminar organizador 2 (ya sin talleres)
DELETE {{baseUrl}}/organizadores/2
